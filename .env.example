# PostgreSQL (development only; replace values in your untracked .env)
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow

# API connection string used by FastAPI / future SQLAlchemy configuration.
DATABASE_URL=postgresql+psycopg://taskflow:taskflow@postgres:5432/taskflow

# Browser-visible endpoint used by the web application.
NEXT_PUBLIC_API_URL=http://localhost:8000
